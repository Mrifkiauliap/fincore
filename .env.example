# ─────────────────────────────────────────
# APP
# ─────────────────────────────────────────
NODE_ENV=development
APP_PORT=3000
APP_SECRET=change-this-secret

# ─────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────
DATABASE_URL=postgresql://fincore:fincore@localhost:5432/fincore_db
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=fincore
DATABASE_PASSWORD=fincore
DATABASE_NAME=fincore_db

# ─────────────────────────────────────────
# REDIS
# ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# ─────────────────────────────────────────
# WHATSAPP (WAHA)
# ─────────────────────────────────────────
WAHA_BASE_URL=http://localhost:3001
WAHA_API_KEY=your-waha-api-key
WAHA_SESSION=default
WAHA_WEBHOOK_SECRET=your-webhook-secret

# ─────────────────────────────────────────
# AI PROVIDERS
# ─────────────────────────────────────────
SUMOPOD_API_KEY=your-sumopod-api-key
SUMOPOD_BASE_URL=https://api.sumopod.com

# ─────────────────────────────────────────
# VOICE TRANSCRIPTION
# ─────────────────────────────────────────
GROQ_API_KEY=your-groq-api-key

# ─────────────────────────────────────────
# OCR / VISION
# ─────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key

# ─────────────────────────────────────────
# STORAGE (media files)
# ─────────────────────────────────────────
STORAGE_TYPE=local
# STORAGE_TYPE=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_REGION=ap-southeast-1

# ─────────────────────────────────────────
# BULL BOARD
# ─────────────────────────────────────────
BULL_BOARD_USERNAME=admin
BULL_BOARD_PASSWORD=admin123

# ─────────────────────────────────────────
# WORKER
# ─────────────────────────────────────────
WORKER_PORT=3002
WORKER_CONCURRENCY=5

# ─────────────────────────────────────────
# SENDER
# ─────────────────────────────────────────
SENDER_PORT=3003
