# ─────────────────────────────────────────
# APP
# ─────────────────────────────────────────
NODE_ENV=development
APP_PORT=3000
APP_SECRET=change-this-secret
LOG_LEVEL=info

# ─────────────────────────────────────────
# PERSONAL ACCESS CONTROL
# ─────────────────────────────────────────
# Only messages from this WA number are processed. Format: 628xxxxxxxxxx
OWNER_PHONE=628xxxxxxxxx
OWNER_LID=131xxxxxxxxxx@lid
# Optional: only process messages starting with this prefix (for multi-instance WA sharing)
# Example: FINCORE_TRIGGER_PREFIX=💰
# FINCORE_TRIGGER_PREFIX=

# ─────────────────────────────────────────
# CLOUDFLARE TUNNEL & DOMAIN
# ─────────────────────────────────────────
APP_DOMAIN=fincore.example.com
CLOUDFLARE_TUNNEL_TOKEN=change-this-token

# ─────────────────────────────────────────
# DATABASE (Gunakan 'postgres' jika menggunakan docker-compose)
# ─────────────────────────────────────────
DATABASE_URL=postgresql://fincore:fincore@postgres:5432/fincore_db
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=fincore
DATABASE_PASSWORD=fincore
DATABASE_NAME=fincore_db

# ─────────────────────────────────────────
# VALKEY (Gunakan 'valkey' jika menggunakan docker-compose)
# ─────────────────────────────────────────
VALKEY_URL=redis://valkey:6379
VALKEY_HOST=valkey
VALKEY_PORT=6379

# ─────────────────────────────────────────
# WHATSAPP (WAHA)
# ─────────────────────────────────────────
WAHA_BASE_URL=http://localhost:3001
WAHA_API_KEY=your-waha-api-key
WAHA_SESSION=default
WAHA_WEBHOOK_HMAC_KEY=your-webhook-secret

# ─────────────────────────────────────────
# AI PROVIDERS
# ─────────────────────────────────────────
SUMOPOD_API_KEY=your-sumopod-api-key
SUMOPOD_BASE_URL=https://api.sumopod.com

# Model overrides (Optional - default values shown)
# AI_EXTRACTION_MODEL=gpt-4o-mini
# AI_SUMMARY_MODEL=gpt-4o-mini
# AI_VISION_MODEL=gemini-2.5-flash
# AI_VOICE_MODEL=whisper-large-v3
# AI_CLASSIFICATION_MODEL=gemini/gemini-2.0-flash-lite

# ─────────────────────────────────────────
# VOICE TRANSCRIPTION
# ─────────────────────────────────────────
GROQ_API_KEY=your-groq-api-key

# ─────────────────────────────────────────
# OCR / VISION
# ─────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key

# ─────────────────────────────────────────
# STORAGE (media files)
# ─────────────────────────────────────────
STORAGE_TYPE=local
LOCAL_UPLOAD_DIR=/opt/fincore/uploads
# STORAGE_TYPE=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_REGION=ap-southeast-

# ─────────────────────────────────────────
# FINANCE WEBHOOK
# ─────────────────────────────────────────
# Format Legacy (Akan didaftarkan otomatis sebagai subscriber 'LEGACY'):
FINANCE_CORE_WEBHOOK_URL=https://finance.example.com/api/webhook/fincore
FINANCE_CORE_WEBHOOK_SECRET=my-super-secret-key-123

# Format Baru (Modern) yang mendukung multi-subscriber & filter tipe event:
# Gunakan format: FINCORE_WEBHOOK_<NAMA_APP>=<url>|<secret>|<event_types>
# Contoh:
# FINCORE_WEBHOOK_FINANCE_CORE=https://finance.example.com/api/webhook/fincore|my-super-secret-key-123|*
# FINCORE_WEBHOOK_ZAPIER=https://hooks.zapier.com/hooks/catch/...|zapier-secret|transaction.created

# ─────────────────────────────────────────
# BULL BOARD
# ─────────────────────────────────────────
BULL_BOARD_USERNAME=admin
BULL_BOARD_PASSWORD=admin123

# ─────────────────────────────────────────
# WORKER
# ─────────────────────────────────────────
WORKER_CONCURRENCY=5
